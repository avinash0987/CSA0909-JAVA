package studyopedia;

public class AverageSum {

    public static void main(String[] args) {
        int a = 10, b = 20, c = 30;
        int sum = a + b + c;
        double average = sum / 3.0;

        System.out.println("Sum is: " + sum);
        System.out.println("Average is: " + average);
    }
}
